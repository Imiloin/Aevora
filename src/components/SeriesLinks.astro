---
import Folder from '@components/icons/Folder.astro';
import { slugify } from '@utils/slug';

const { series } = Astro.props;
---

{series && series.length > 0 && (
  <div class="series m-[0.5rem_0_1.5rem_0] inline-flex items-center gap-2 rounded-3xl bg-(--bg-inverse) px-4 py-2 text-[0.9em]">
    <Folder />
    <div class="flex text-(--text-inverse)">
      {series.map((entry: string, index: number) => (
        <>
          <a
            class="rounded-sm p-1 text-(--text-inverse) no-underline shadow-none transition-all duration-300 ease-in-out hover:bg-(--bg-inverse-hover) hover:shadow-none"
            href={`/series/${slugify(entry)}/`}
          >
            {entry}
          </a>
          {index < series.length - 1 && <span class="p-1 text-(--text-inverse)">/</span>}
        </>
      ))}
    </div>
  </div>
)}

<style>
  .series :global(svg) {
    color: var(--text-inverse);
  }
</style>
