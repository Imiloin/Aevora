---
import AstroLogo from '@components/icons/AstroLogo.astro';

const today = new Date();

interface Props {
  width?: string;
  theme?: 'light' | 'dark';
}

const { width = '800px', theme = 'light' } = Astro.props as Props;
---

<footer class:list={['site-footer flex justify-center', theme === 'dark' && 'site-footer--dark']}>
  <div class="footer-content">
    <div class="text-left">&copy; {today.getFullYear()} Imiloin. All rights reserved.</div>
    <div class="astro text-right">
      Powered by
      <a data-shrink href="https://astro.build" aria-label="Astro website">
        <AstroLogo />
      </a>
      .
    </div>
  </div>
</footer>

<style define:vars={{ width }}>
  .site-footer {
    background: var(--bg-page);
    color: var(--text-secondary);
  }

  .site-footer--dark {
    position: relative;
    z-index: 1;
    flex: none;
    background: transparent;
    color: var(--text-inverse-secondary);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2em;
    width: var(--width);
    max-width: calc(100% - 2em);
  }

  .astro a {
    text-decoration: none;
    color: inherit;

    &:hover {
      color: var(--text-primary);
    }
  }

  .site-footer--dark .footer-content {
    padding-bottom: 2em;
  }

  .site-footer--dark .astro a:hover {
    color: var(--text-inverse);
  }

  @media (max-width: 640px) {
    .footer-content {
      font-size: 0.8em;
    }
  }
</style>
